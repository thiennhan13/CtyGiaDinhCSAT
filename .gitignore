# ==========================================
# CSAT Tutor Portal - Professional .gitignore
# Next.js / TypeScript / Supabase / Vercel
# ==========================================

# 1. Dependencies
node_modules/
.pnp
.pnp.js
.npm/
.yarn/cache
.pnpm-store/

# 2. Next.js & TypeScript Build Cache
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# 3. Environment Variables (Security)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
*.env

# 4. Logs & Debug
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# 5. Vercel & Deployment
.vercel
.vercel/
*.vercel

# 6. IDE, Editors & Tools
.vscode/
.idea/
*.swp
*.swo
*.swn
.eslintcache
.stylelintcache

# 7. OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# 8. Temporary, Backup & Scratch Files
*.bak
*.tmp
*.temp
scratch/
database/tests/.runtime/
.gemini/
.agents/

# Private design handoff; never commit prototypes.
/docs/prototypes/

# Handoff privacy boundary (also enforced for tracked files by check:repo)
.env*
!.env.example
/internal/
/docs/internal/
/private-data/
/backups/
/exports/
/artifacts/
/test-results/
/playwright-report/
.codex/
