# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Vercel Cron Secret
CRON_SECRET="your-cron-secret"

# Server request origin: set the exact HTTPS deployment origin in Production.
# Local example. No trailing slash; do not reuse Production origin on Preview.
APP_ORIGIN="http://localhost:3000"
# Optional dedicated server-side HMAC secret for Auth rate limiting.
# When empty, code falls back to SUPABASE_SERVICE_ROLE_KEY; never expose either.
AUTH_RATE_LIMIT_KEY=""

# Registration intake: require migration18/24 and a random hash key before enabling.
# New registration requests do not create email outbox rows or send messages.
CONSULTATIONS_HASH_KEY=""
CONSULTATIONS_ENABLED="false"

# CSAT transactional email (server only; keep disabled until separately accepted).
CSAT_EMAIL_FROM="CSAT <thongbao@notify.csatoj.vn>"
CSAT_EMAIL_REPLY_TO="csattutor@gmail.com"
RESEND_API_KEY=""
CONSULTATIONS_EMAIL_ENABLED="false"
# Generate separate random secrets >=32 characters for CRON_SECRET,
# CONSULTATIONS_HASH_KEY and AUTH_RATE_LIMIT_KEY if configured.
# Parent provisioning only: supply CSAT_PARENT_INITIAL_PASSWORD from a secret
# manager to the operator process. Do not store its value here or in deployment.
# See docs/BACKEND_COMPLETION.md; dry-run is default, apply needs --project-ref.
# VERCEL_ENV is set by Vercel; do not override it locally or on Preview.
