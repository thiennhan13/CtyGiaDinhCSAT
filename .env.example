# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Vercel Cron Secret
CRON_SECRET="your-cron-secret"

# Server request origin: set the exact HTTPS deployment origin in Production.
# Local example. No trailing slash; do not reuse Production origin on Preview.
APP_ORIGIN="http://localhost:3000"
# Public Google Search Console verification token from the Portal URL-prefix property.
# Set before building/deploying; only the homepage emits it. Empty means no verification tag.
GOOGLE_SITE_VERIFICATION=""
# Optional server-side HMAC secret shared by staff login and Google OAuth/parent claim.
# When empty, code falls back to SUPABASE_SERVICE_ROLE_KEY; never expose either.
AUTH_RATE_LIMIT_KEY=""

# Login-only Cloudflare Turnstile (parent and staff). Defaults off until configured.
# Site key is public via login-page props; secret must remain server-only.
# APP_ORIGIN supplies the exact hostname accepted by server-side verification.
TURNSTILE_LOGIN_ENABLED="false"
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Registration intake: require migration18/24 and a random hash key before enabling.
# New registration requests do not create email outbox rows or send messages.
CONSULTATIONS_HASH_KEY=""
CONSULTATIONS_ENABLED="false"

# CSAT transactional email (server only; keep disabled until separately accepted).
CSAT_EMAIL_FROM="CSAT <thongbao@notify.csatoj.vn>"
CSAT_EMAIL_REPLY_TO="csattutor@gmail.com"
RESEND_API_KEY=""
CONSULTATIONS_EMAIL_ENABLED="false"
# Generate separate random secrets >=32 characters for CRON_SECRET,
# CONSULTATIONS_HASH_KEY and AUTH_RATE_LIMIT_KEY if configured.
# Parents use Google via Supabase after migration30. Configure Google provider in Supabase,
# allow APP_ORIGIN/auth/callback. See docs/PORTAL_GOOGLE_GRANTS_ROLLOUT.md.
# VERCEL_ENV is set by Vercel; do not override it locally or on Preview.

# Server-only OJ grants/accounts (keep disabled until integration acceptance).
CSAT_OJ_ENABLED="false"
CSAT_OJ_ORIGIN="https://csatoj.vn"
CSAT_OJ_INSTANCE_ID=""
CSAT_OJ_READ_KEY=""
CSAT_OJ_MANAGE_KEY=""
# Maintenance blocks Portal APIs, Auth, cron and operational pages, including intake.
PORTAL_MAINTENANCE="false"
