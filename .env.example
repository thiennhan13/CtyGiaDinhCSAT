# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Vercel Cron Secret
CRON_SECRET="your-cron-secret"

# CSAT transactional email (server only; use Production scope on Vercel)
# Local example. Production origin is documented in docs/SETUP_VERCEL_SUPABASE.md.
APP_ORIGIN="http://localhost:3000"
CSAT_EMAIL_FROM="CSAT <thongbao@notify.csatoj.vn>"
CSAT_EMAIL_REPLY_TO="csattutor@gmail.com"
RESEND_API_KEY=""
CONSULTATIONS_HASH_KEY=""
CONSULTATIONS_ENABLED="false"
CONSULTATIONS_EMAIL_ENABLED="false"
# Generate separate random secrets >=32 characters for CRON_SECRET and HASH_KEY.
# VERCEL_ENV is set by Vercel; do not override it locally or on Preview.
